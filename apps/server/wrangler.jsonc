// ZecDoor server + static site, one Worker on one domain (decision D9: Cloudflare free tier).
// Production (top level) serves zecdoor.0xo.in (taken over from the first-deploy Worker at go-live,
// 5 Oct 2026). `--env preview` deploys a separate Worker on workers.dev for review, with its own
// storage and no scheduled jobs.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zecdoor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../dist/site",
    "binding": "ASSETS",
    // The Worker runs first for the API and for page requests (to send plain http to https);
    // static files (scripts, styles, images, fonts) are served straight from the asset store.
    "run_worker_first": ["/*", "!/_next/*", "!/docs/_next/*", "!/app/assets/*", "!/demo/*", "!/*.webp", "!/*.svg", "!/*.png", "!/*.woff2", "!/*.js", "!/*.css"],
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [{ "binding": "STATE", "id": "95211d40dddc445fa9aa31f0fa031e46" }],
  "triggers": { "crons": ["*/30 * * * *", "17 3 * * *"] },
  "workers_dev": false,
  "vars": {
    // Our own test wallet's Orchard receiver and Solana wallet, used only in dry quotes.
    "FEE_TEST_RECIPIENT": "u1c5zssk2r6nasyar5amt5pw3szaes8h5wmer3qsaqkc2j6kjcae2lu95ycle3r8vvcdvpyfm7pdnx7624ckp7h5uwfa72l8y54cf4gu8m",
    "FEE_TEST_REFUND": "3QFJWVEk6tpf52gtk3saAP1nkuci6GRMNHx72etsi67T"
  },
  // HASH_SALT is a secret: `wrangler secret put HASH_SALT` (and `--env preview`).
  "routes": [{ "pattern": "zecdoor.0xo.in", "custom_domain": true }],
  "env": {
    "preview": {
      "name": "zecdoor-preview",
      "workers_dev": true,
      "routes": [],
      "triggers": { "crons": [] },
      "kv_namespaces": [{ "binding": "STATE", "id": "29c9ca02a56d4ea48e1e6726c5095762" }],
      "vars": {
        "FEE_TEST_RECIPIENT": "u1c5zssk2r6nasyar5amt5pw3szaes8h5wmer3qsaqkc2j6kjcae2lu95ycle3r8vvcdvpyfm7pdnx7624ckp7h5uwfa72l8y54cf4gu8m",
        "FEE_TEST_REFUND": "3QFJWVEk6tpf52gtk3saAP1nkuci6GRMNHx72etsi67T"
      }
    }
  }
}
